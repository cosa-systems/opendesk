---
# Secrets provisioned by the opendesk-secrets chart. Instead of a static list, this iterates the
# openDesk value trees that may carry externalized secrets and picks up every one that is fully
# defined as per convention as a node that provides {value, create, name, key, [extraData]}.
# The chart renders a Secret only for `create: true`.
#
# Credentials that name the same Secret are merged into one entry: the first one found keeps its
# `key`, every further one contributes its `key`/`value` as `extraData` (next to its own
# `extraData`), so one Secret carries all of them - an object store identity's `username` and
# `secretKey` share theirs by default. They have to agree on `create`, and a managed key may not
# arrive with two different values; either mismatch fails the render rather than silently dropping
# a credential. A bring-your-own Secret is referenced as often as it is used and needs no merging.
#
# Trees scanned: the central `secrets` tree (secrets.yaml.gotmpl) plus the domain files that now
# co-locate their own secrets: `objectstores` (objectstores.yaml.gotmpl), `databases`
# (database.yaml.gotmpl), `cache` (cache.yaml.gotmpl), `smtp` (smtp.yaml.gotmpl) and `turn`
# (turn.yaml.gotmpl). The last two have no component level of their own - `smtp.password` and
# `turn.credentials` sit directly under their trees - so each is wrapped as a single component
# (`smtp`, `turn`) to fit the `<tree>.<component>.<credential>` shape; `smtp.dkim.key.secret`
# carries no `create` and is left alone by the scan, as before.
#
# NOTE: this descends up to FOUR levels deep, matching every nesting shape used today:
#   - `<tree>.<component>.<credential>`                     e.g. secrets.cassandra.rootPassword,
#                                                                objectstores.nextcloud.secretKey,
#                                                                databases.keycloak.password
#   - `<tree>.<component>.<group>.<credential>`             e.g. secrets.keycloak.clientSecret.xwiki
#   - `<tree>.<component>.<group>.<subgroup>.<credential>`  e.g. secrets.nubus.provisioning.api.<x>
# At each level a node that itself carries a `name` (+ `create`) is an externalized secret; a node
# without a `name` is treated as a grouping node and its children are scanned one level further,
# down to the fourth level (the deepest nesting the value trees use).
{{- $entries := list }}
{{- range $tree := (list .Values.secrets .Values.objectstores .Values.databases .Values.cache) }}
{{- range $component, $entries_ := $tree }}
{{- range $key, $node := $entries_ }}
{{- if kindIs "map" $node }}
{{- if and (hasKey $node "name") (hasKey $node "create") }}
{{- $entries = append $entries (dict "name" $node.name "create" $node.create "key" $node.key "value" $node.value "extraData" (index $node "extraData" | default dict)) }}
{{- else }}
{{- range $subkey, $subnode := $node }}
{{- if kindIs "map" $subnode }}
{{- if and (hasKey $subnode "name") (hasKey $subnode "create") }}
{{- $entries = append $entries (dict "name" $subnode.name "create" $subnode.create "key" $subnode.key "value" $subnode.value "extraData" (index $subnode "extraData" | default dict)) }}
{{- else }}
{{- range $subsubkey, $subsubnode := $subnode }}
{{- if and (kindIs "map" $subsubnode) (hasKey $subsubnode "name") (hasKey $subsubnode "create") }}
{{- $entries = append $entries (dict "name" $subsubnode.name "create" $subsubnode.create "key" $subsubnode.key "value" $subsubnode.value "extraData" (index $subsubnode "extraData" | default dict)) }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}
{{- /* Merge the entries that name the same Secret. A bring-your-own Secret (create: false) is
       referenced as often as it is used - one entry is enough, the chart renders nothing for it. A
       managed Secret collects every key its credentials contribute; the same key twice is only a
       conflict when it comes with two different values. */}}
{{- $byName := dict }}
{{- $order := list }}
{{- range $e := $entries }}
{{- if hasKey $byName $e.name }}
{{- $m := index $byName $e.name }}
{{- if ne (toString $m.create) (toString $e.create) }}
{{- fail (printf "opendesk-secrets: the credentials sharing the Secret %q disagree on create" $e.name) }}
{{- end }}
{{- if $e.create }}
{{- $adds := merge (dict $e.key $e.value) $e.extraData }}
{{- range $k, $v := $adds }}
{{- $have := ternary $m.value (index $m.extraData $k) (eq $k $m.key) }}
{{- if or (eq $k $m.key) (hasKey $m.extraData $k) }}
{{- if ne (toString $have) (toString $v) }}
{{- fail (printf "opendesk-secrets: the Secret %q would carry the key %q with two different values" $e.name $k) }}
{{- end }}
{{- else }}
{{- $_ := set $m.extraData $k $v }}
{{- end }}
{{- end }}
{{- end }}
{{- else }}
{{- $_ := set $byName $e.name $e }}
{{- $order = append $order $e.name }}
{{- end }}
{{- end }}
managedSecrets:
{{- range $n := $order }}
{{- $m := index $byName $n }}
  - name: {{ $m.name | quote }}
    create: {{ $m.create }}
    key: {{ $m.key | quote }}
    value: {{ $m.value | quote }}
    {{- with $m.extraData }}
    extraData:
      {{- toYaml . | nindent 6 }}
    {{- end }}
{{- end }}
...
