---
{{- if .Values.externalSecrets.enabled }}
# When set, the chart skips emitting its own Secret and consumers
# read from the cluster Secret at the same name (provisioned
# out-of-band). The inline admin/identities below stay as defaults.
existingSecret:
  name: "seaweedfs-config"
{{- end }}
admin:
  accessKey: "admin"
  secretKey: "{{ .Values.secrets.minio.rootPassword }}"

identities:
  {{- range $name, $store := .Values.objectstores }}
  {{- if or (not (dig "enterprise" false $store)) (eq (env "OPENDESK_ENTERPRISE") "true") }}
  - name: {{ $name | quote }}
    credentials:
      - accessKey: "{{ $store.username }}"
        secretKey: "{{ index $.Values.secrets.minio (dig "userSecretKey" (printf "%sUser" $name) $store) }}"
    actions:
      {{- range $store.actions }}
      - "{{ . }}:{{ $store.bucket }}"
      {{- end }}
  {{- end }}
  {{- end }}
...
