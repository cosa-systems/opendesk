---
global:
  imagePullSecrets:
    {{ .Values.global.imagePullSecrets | toYaml | nindent 4 }}

appInit:
  resources:
    {{ .Values.resources.openprojectAppInit | toYaml | nindent 4 }}

containerSecurityContext:
  enabled: true
  privileged: false
  runAsUser: 1000
  runAsGroup: 1000
  allowPrivilegeEscalation: false
  capabilities:
    drop:
      - "ALL"
  seccompProfile:
    type: "RuntimeDefault"
  readOnlyRootFilesystem: {{ .Values.technical.openproject.readOnlyRootFilesystem }}
  runAsNonRoot: true
  seLinuxOptions:
    {{ .Values.seLinuxOptions.openproject | toYaml | nindent 4 }}

dbInit:
  image:
    registry: {{ coalesce .Values.repositories.image.dockerHub .Values.global.imageRegistry .Values.images.openprojectDbInit.registry | quote }}
    repository: {{ .Values.images.openprojectDbInit.repository | quote }}
    tag: {{ .Values.images.openprojectDbInit.tag | quote }}
    imagePullPolicy: {{ .Values.global.imagePullPolicy | quote }}
  resources:
    {{ .Values.resources.openprojectDbInit | toYaml | nindent 4 }}

environment:
  {{- if and (eq (env "OPENDESK_ENTERPRISE") "true") .Values.enterpriseKeys.openproject.token }}
  OPENPROJECT_SEED__ENTERPRISE__TOKEN: {{ .Values.enterpriseKeys.openproject.token | quote }}
  {{- end }}
# Ref. https://www.openproject.org/docs/installation-and-operations/configuration/environment/
  {{- with .Values.technical.openproject.ssrfIpAllowlist }}
  # Permit specific otherwise-blocked IPs/ranges through OpenProject's outbound
  # SSRF filter. Needed when OpenProject fetches an asset via its own public
  # hostname (e.g. the design-logo seed) that in-cluster DNS resolves to a
  # private/CGNAT ingress IP the ssrf_filter gem blocks by default.
  OPENPROJECT_SSRF_PROTECTION_IP_ALLOWLIST: {{ . | quote }}
  {{- end }}
  OPENPROJECT_APP__TITLE: "Projekte - {{ .Values.theme.texts.productName }}"
  OPENPROJECT_LOG__LEVEL: {{ if .Values.debug.enabled }}"debug"{{ else }}"info"{{ end }}
  OPENPROJECT_LOGIN__REQUIRED: "true"
  OPENPROJECT_USER__DEFAULT__TIMEZONE: "Europe/Berlin"
  OPENPROJECT_OAUTH__ALLOW__REMAPPING__OF__EXISTING__USERS: "true"
  OPENPROJECT_OMNIAUTH__DIRECT__LOGIN__PROVIDER: "keycloak"
  OPENPROJECT_EMAIL__DELIVERY__METHOD: "smtp"
  OPENPROJECT_DEFAULT__COMMENT__SORT__ORDER: "desc"
  # Ref.: https://www.openproject.org/docs/system-admin-guide/authentication/ldap-connections/#enable-status-synchronization
  OPENPROJECT_LDAP__USERS__SYNC__STATUS: "true"
  # Ref.: https://www.openproject-edge.com/docs/installation-and-operations/configuration/#seeding-ldap-connections
  OPENPROJECT_SEED_LDAP_OPENDESK_HOST: {{ .Values.ldap.host | quote }}
  OPENPROJECT_SEED_LDAP_OPENDESK_PORT: "389"
  {{- if not .Values.externalSecrets.enabled }}
  OPENPROJECT_SEED_LDAP_OPENDESK_BINDPASSWORD: {{ .Values.secrets.nubus.ldapSearch.openproject.value | quote }}
  {{- end }}
  OPENPROJECT_SEED_LDAP_OPENDESK_SECURITY: "plain_ldap"
  OPENPROJECT_SEED_LDAP_OPENDESK_BINDUSER: "uid=ldapsearch_openproject,cn=users,{{ .Values.ldap.baseDn }}"
  OPENPROJECT_SEED_LDAP_OPENDESK_BASEDN: "{{ .Values.ldap.baseDn }}"
  OPENPROJECT_SEED_LDAP_OPENDESK_FILTER:
    "(&(objectClass=opendeskProjectmanagementUser)(opendeskProjectmanagementEnabled=TRUE))"
  OPENPROJECT_SEED_LDAP_OPENDESK_SYNC__USERS: "true"
  OPENPROJECT_SEED_LDAP_OPENDESK_LOGIN__MAPPING: "uid"
  OPENPROJECT_SEED_LDAP_OPENDESK_FIRSTNAME__MAPPING: "givenName"
  OPENPROJECT_SEED_LDAP_OPENDESK_LASTNAME__MAPPING: "sn"
  OPENPROJECT_SEED_LDAP_OPENDESK_MAIL__MAPPING: "mailPrimaryAddress"
  OPENPROJECT_SEED_LDAP_OPENDESK_ADMIN__MAPPING: "opendeskProjectmanagementAdmin"
  OPENPROJECT_SEED_LDAP_OPENDESK_GROUPFILTER_OPENDESK_BASE: "{{ .Values.ldap.baseDn }}"
  OPENPROJECT_SEED_LDAP_OPENDESK_GROUPFILTER_OPENDESK_FILTER:
    "(&(objectClass=opendeskProjectmanagementGroup)(opendeskProjectmanagementEnabled=TRUE))"
  OPENPROJECT_SEED_LDAP_OPENDESK_GROUPFILTER_OPENDESK_SYNC__USERS: "true"
  OPENPROJECT_SEED_LDAP_OPENDESK_GROUPFILTER_OPENDESK_GROUP__ATTRIBUTE: "cn"
  {{- if not .Values.externalSecrets.enabled }}
  OPENPROJECT_AUTHENTICATION_GLOBAL__BASIC__AUTH_USER: {{ .Values.secrets.openproject.apiAdminUsername.value | quote }}
  OPENPROJECT_AUTHENTICATION_GLOBAL__BASIC__AUTH_PASSWORD: {{ .Values.secrets.openproject.apiAdminPassword.value | quote }}
  OPENPROJECT_SOUVAP__NAVIGATION__SECRET: {{ .Values.secrets.centralnavigation.apiKey.value | quote }}
  {{- end }}
  OPENPROJECT_SOUVAP__NAVIGATION__URL: "https://{{ .Values.global.hosts.nubus }}.{{ .Values.global.domain }}/univention/portal/navigation.json?base=https%3A//{{ .Values.global.hosts.nubus }}.{{ .Values.global.domain }}"
  OPENPROJECT_SMTP__DOMAIN: {{ .Values.global.mailDomain | default .Values.global.domain | quote }}
  OPENPROJECT_SMTP__USER__NAME: {{ printf "%s@%s" "opendesk-system" ( .Values.global.mailDomain | default .Values.global.domain ) }}
  {{- if not .Values.externalSecrets.enabled }}
  OPENPROJECT_SMTP__PASSWORD: {{ .Values.secrets.postfix.opendeskSystemPassword.value | quote }}
  {{- end }}
  OPENPROJECT_SMTP__PORT: 587
  OPENPROJECT_SMTP__SSL: "false" # (default=false)
  OPENPROJECT_SMTP__ADDRESS: {{ printf "%s.%s.svc.%s" "postfix" (.Values.apps.postfix.namespace | default .Release.Namespace) .Values.cluster.networking.domain | quote }}
  OPENPROJECT_SMTP__AUTHENTICATION: "cram_md5"
  OPENPROJECT_SMTP__ENABLE__STARTTLS__AUTO: "false"
  OPENPROJECT_SMTP__OPENSSL__VERIFY__MODE: "none"
  OPENPROJECT_SSRF__PROTECTION__IP__ALLOWLIST: {{ join " " .Values.cluster.networking.cidr | quote }}
  OPENPROJECT_MAIL__FROM: "{{ .Values.smtp.localpartNoReply }}@{{ .Values.global.mailDomain | default .Values.global.domain }}"
  OPENPROJECT_HOME__URL: {{ printf "https://%s.%s/" .Values.global.hosts.nubus .Values.global.domain | quote }}
  OPENPROJECT_OPENID__CONNECT_KEYCLOAK_ISSUER: "https://{{ .Values.global.hosts.keycloak }}.{{ .Values.global.domain }}/realms/{{ .Values.platform.realm }}"
  OPENPROJECT_OPENID__CONNECT_KEYCLOAK_POST__LOGOUT__REDIRECT__URI: "https://{{ .Values.global.hosts.openproject }}.{{ .Values.global.domain }}/"
  OPENPROJECT_PLUGIN__OPENPROJECT__AVATARS: "{enable_gravatars: false, enable_local_avatars: true}"

  OPENPROJECT_SEED_DESIGN_PRIMARY__BUTTON__COLOR: {{ .Values.theme.colors.primary | quote }}
  OPENPROJECT_SEED_DESIGN_ACCENT__COLOR: {{ .Values.theme.colors.primary | quote }}
  OPENPROJECT_SEED_DESIGN_HEADER__BG__COLOR: {{ .Values.theme.colors.white | quote }}
  OPENPROJECT_SEED_DESIGN_HEADER__ITEM__BG__HOVER__COLOR: {{ .Values.theme.colors.secondaryGreyLight | quote }}
  OPENPROJECT_SEED_DESIGN_MAIN__MENU__BG__COLOR: {{ .Values.theme.colors.white | quote }}
  OPENPROJECT_SEED_DESIGN_MAIN__MENU__BG__SELECTED__BACKGROUND: {{ .Values.theme.colors.primary | quote }}
  OPENPROJECT_SEED_DESIGN_MAIN__MENU__BG__HOVER__BACKGROUND: {{ .Values.theme.colors.secondaryGreyLight | quote }}
  OPENPROJECT_SEED_DESIGN_LOGO: "https://{{ .Values.global.hosts.openproject }}.{{ .Values.global.domain }}/opendesk-static-files/logo.svg"
  OPENPROJECT_SEED_DESIGN_LOGO__MOBILE: "https://{{ .Values.global.hosts.openproject }}.{{ .Values.global.domain }}/opendesk-static-files/logomobile.svg"
  OPENPROJECT_SEED_DESIGN_FAVICON: "https://{{ .Values.global.hosts.openproject }}.{{ .Values.global.domain }}/opendesk-static-files/favicon.svg"
  OPENPROJECT_SEED_DESIGN_TOUCH__ICON: "https://{{ .Values.global.hosts.openproject }}.{{ .Values.global.domain }}/opendesk-static-files/touchicon.svg"
  OPENPROJECT_SEED_DESIGN_EXPORT__LOGO: "https://{{ .Values.global.hosts.openproject }}.{{ .Values.global.domain }}/opendesk-static-files/{{ base .Values.theme.imagery.projects.pdfExportLogoPath | lower }}"
  OPENPROJECT_SEED_DESIGN_EXPORT__COVER: "https://{{ .Values.global.hosts.openproject }}.{{ .Values.global.domain }}/opendesk-static-files/{{ base .Values.theme.imagery.projects.pdfExportCoverPath | lower }}"
  OPENPROJECT_SEED_DESIGN_EXPORT__FOOTER: "https://{{ .Values.global.hosts.openproject }}.{{ .Values.global.domain }}/opendesk-static-files/{{ base .Values.theme.imagery.projects.pdfExportFooterPath | lower }}"
  {{- if .Values.theme.imagery.projects.pdfExportFontRegularUrl }}
  OPENPROJECT_SEED_DESIGN_EXPORT__FONT__REGULAR: {{ .Values.theme.imagery.projects.pdfExportFontRegularUrl | quote }}
  {{- end }}
  {{- if .Values.theme.imagery.projects.pdfExportFontBoldUrl }}
  OPENPROJECT_SEED_DESIGN_EXPORT__FONT__BOLD: {{ .Values.theme.imagery.projects.pdfExportFontBoldUrl | quote }}
  {{- end }}
  {{- if .Values.theme.imagery.projects.pdfExportFontItalicUrl }}
  OPENPROJECT_SEED_DESIGN_EXPORT__FONT__ITALIC: {{ .Values.theme.imagery.projects.pdfExportFontItalicUrl | quote }}
  {{- end }}
  {{- if .Values.theme.imagery.projects.pdfExportFontBoldItalicUrl }}
  OPENPROJECT_SEED_DESIGN_EXPORT__FONT__BOLD__ITALIC: {{ .Values.theme.imagery.projects.pdfExportFontBoldItalicUrl | quote }}
  {{- end }}

  {{- if .Values.certificate.selfSigned }}
  SSL_CERT_FILE: "/etc/ssl/certs/ca-certificates.crt"
  {{- end }}

{{- if .Values.externalSecrets.enabled }}
# Credentials previously baked into `environment:` and the seed-admin
# password + OIDC client secret come from the cluster-side Secret here
# instead. The chart concatenates `extraEnvVars` with the `environment:`
# map into the pod's env block, so secretKeyRef wins for the duplicated
# names.
extraEnvVars:
  - name: "OPENPROJECT_SEED_LDAP_OPENDESK_BINDPASSWORD"
    valueFrom:
      secretKeyRef:
        name: {{ .Values.externalSecrets.name | quote }}
        key: "NUBUS_LDAPSEARCH_OPENPROJECT"
  - name: "OPENPROJECT_AUTHENTICATION_GLOBAL__BASIC__AUTH_USER"
    valueFrom:
      secretKeyRef:
        name: {{ .Values.externalSecrets.name | quote }}
        key: "OPENPROJECT_API_ADMIN_USERNAME"
  - name: "OPENPROJECT_AUTHENTICATION_GLOBAL__BASIC__AUTH_PASSWORD"
    valueFrom:
      secretKeyRef:
        name: {{ .Values.externalSecrets.name | quote }}
        key: "OPENPROJECT_API_ADMIN_PASSWORD"
  - name: "OPENPROJECT_SOUVAP__NAVIGATION__SECRET"
    valueFrom:
      secretKeyRef:
        name: {{ .Values.externalSecrets.name | quote }}
        key: "CENTRALNAVIGATION_API_KEY"
  - name: "OPENPROJECT_SMTP__PASSWORD"
    valueFrom:
      secretKeyRef:
        name: {{ .Values.externalSecrets.name | quote }}
        key: "POSTFIX_OPENDESK_SYSTEM_PASSWORD"
  - name: "OPENPROJECT_SEED_ADMIN_USER_PASSWORD"
    valueFrom:
      secretKeyRef:
        name: {{ .Values.externalSecrets.name | quote }}
        key: "OPENPROJECT_ADMIN_PASSWORD"
  - name: "OPENPROJECT_OPENID__CONNECT_KEYCLOAK_SECRET"
    valueFrom:
      secretKeyRef:
        name: {{ .Values.externalSecrets.name | quote }}
        key: "KEYCLOAK_CLIENTSECRET_OPENPROJECT"
  - name: "OPENPROJECT_FOG_CREDENTIALS_AWS__ACCESS__KEY__ID"
    valueFrom:
      secretKeyRef:
        name: "opendesk-s3-credentials"
        key: "access-key-id"
  - name: "OPENPROJECT_FOG_CREDENTIALS_AWS__SECRET__ACCESS__KEY"
    valueFrom:
      secretKeyRef:
        name: "opendesk-s3-credentials"
        key: "secret-access-key"
{{- end }}

{{- if .Values.certificate.selfSigned }}
extraVolumes:
  - name: "trusted-cert-secret-volume"
    secret:
      secretName: "opendesk-certificates-ca-tls"
      items:
        - key: "ca.crt"
          path: "ca-certificates.crt"
extraVolumeMounts:
  - name: "trusted-cert-secret-volume"
    mountPath: "/etc/ssl/certs/ca-certificates.crt"
    subPath: "ca-certificates.crt"
{{- end }}

hocuspocus:
  enabled: true
  ingress:
    path: /hocuspocus
    pathType: "Prefix"
  auth:
    {{- if .Values.externalSecrets.enabled }}
    # Chart-native: when existingSecret is set, secret_hocuspocus.yaml skips
    # emitting its random `hocuspocus-secret-auto-generated` Secret (which
    # otherwise regenerates on every offline render and lands in git).
    existingSecret: {{ .Values.externalSecrets.name | quote }}
    secretKey: "OPENPROJECT_HOCUSPOCUS_SECRET"
    {{- else }}
    existingSecret:
    secretKey: secret
    {{- end }}
  networkPolicy:
    enabled: false
  image:
    registry: {{ coalesce .Values.repositories.image.registryOpencodeDe .Values.global.imageRegistry .Values.images.openprojectHocuspocus.registry | quote }}
    repository: {{ .Values.images.openprojectHocuspocus.repository | quote }}
    imagePullPolicy: {{ .Values.global.imagePullPolicy | quote }}
    tag: {{ index (splitList "@" .Values.images.openprojectHocuspocus.tag) 0 | quote }}
    sha256: {{ index (splitList ":" (index (splitList "@" .Values.images.openprojectHocuspocus.tag) 1)) 1 | quote }}
  strategy:
    type: "RollingUpdate"
  podAnnotations:
    intents.otterize.com/service-name: "openproject-hocuspocus"
    {{- with .Values.annotations.openproject.hocuspocusPod }}
    {{ . | toYaml | nindent 4 }}
    {{- end }}
  service:
    port: 1234
  resourcesPreset: ~
  resources:
    {{ .Values.resources.openproject | toYaml | nindent 4 }}

strategy:
  type: "RollingUpdate"

image:
  registry: {{ coalesce .Values.repositories.image.registryOpencodeDe .Values.global.imageRegistry .Values.images.openproject.registry | quote }}
  repository: {{ .Values.images.openproject.repository | quote }}
  imagePullPolicy: {{ .Values.global.imagePullPolicy | quote }}
  tag: {{ .Values.images.openproject.tag | quote }}

memcached:
  bundled: false
  connection:
    host: {{ .Values.cache.openproject.host | quote }}
    port: {{ .Values.cache.openproject.port }}

persistence:
  enabled: false

podAnnotations:
  intents.otterize.com/service-name: "openproject"
  {{- with .Values.annotations.openproject.pod }}
  {{ . | toYaml | nindent 2 }}
  {{- end }}

postgresql:
  bundled: false
  auth:
    {{- if .Values.externalSecrets.enabled }}
    existingSecret: {{ .Values.externalSecrets.dbSecretName | quote }}
    secretKeys:
      userPasswordKey: "PG_OPENPROJECT"
    {{- else }}
    password: {{ .Values.databases.openproject.password.value | quote }}
    {{- end }}
    username: {{ .Values.databases.openproject.username | quote }}
    database: {{ .Values.databases.openproject.name | quote }}
  connection:
    host: {{ .Values.databases.openproject.host | quote }}
    port: {{ .Values.databases.openproject.port }}

probes:
  liveness:
    initialDelaySeconds: 300
    failureThreshold: 30
  readiness:
    initialDelaySeconds: 150
    failureThreshold: 30

openproject:
  {{- if .Values.externalSecrets.enabled }}
  # Chart-native: when secretKeyBase.existingSecret is set,
  # secret_secret_key_base.yaml skips emitting its random
  # `secret-key-base-auto-generated` Secret (which otherwise regenerates on
  # every offline render and lands in git).
  secretKeyBase:
    existingSecret: {{ .Values.externalSecrets.name | quote }}
    secretKey: "OPENPROJECT_SECRET_KEY_BASE"
  {{- end }}
  extraEnvVarsSecret: {{ .Values.secrets.postfix.opendeskSystemPassword.name | quote }}
  # seed will only be executed on initial installation
  seed_locale: "de"
  host: "{{ .Values.global.hosts.openproject }}.{{ .Values.global.domain }}"
  # Will only be set on initial seed / installation
  admin_user:
    name: "OpenProject Internal Admin"
    mail: "openproject-admin@swp-domain.internal"
    password_reset: "false"
    secret: {{ .Values.secrets.openproject.adminPassword.name | quote }}
    secretKeys:
      password: {{ .Values.secrets.openproject.adminPassword.key | quote }}
    # Lock the admin user, preventing internal logins.
    # Switch to true once the NC filestore bootstrapping is optimized.
    locked: false
  oidc:
    enabled: true
    authorizationEndpoint: "/realms/{{ .Values.platform.realm }}/protocol/openid-connect/auth"
    endSessionEndpoint : "https://{{ .Values.global.hosts.keycloak }}.{{ .Values.global.domain }}/realms/{{ .Values.platform.realm }}/protocol/openid-connect/logout"
    host: "{{ .Values.global.hosts.keycloak }}.{{ .Values.global.domain }}"
    identifier: "opendesk-openproject"
    provider: "keycloak"
    scope: "[openid,opendesk-openproject-scope]"
    {{- if not .Values.externalSecrets.enabled }}
    secret: {{ .Values.secrets.keycloak.clientSecret.openproject.value | quote }}
    {{- end }}
    tokenEndpoint: "/realms/{{ .Values.platform.realm }}/protocol/openid-connect/token"
    userinfoEndpoint: "/realms/{{ .Values.platform.realm }}/protocol/openid-connect/userinfo"
    attribute_map:
      login: "opendesk_username"
      admin: "openproject_admin"
  # Tie tmp-volume usage to the root-FS mode, exactly as the chart's own
  # default does: a read-only root FS needs RWO PVCs for /tmp + /app/tmp
  # (the chart can't use emptyDir there, k8s#110835); a writable root FS
  # writes /tmp on the container's own layer and needs no PVCs.
  useTmpVolumes: {{ .Values.technical.openproject.readOnlyRootFilesystem }}
  tmpVolumesStorage: {{ .Values.persistence.storages.openprojectTmp.size | quote }}
  tmpVolumesStorageClassName: {{ coalesce .Values.persistence.storages.openprojectTmp.storageClassName .Values.persistence.storageClassNames.RWO | quote }}
  tmpVolumesAnnotations:
    {{ .Values.annotations.openproject.openprojectTempVolumes | toYaml | nindent 4 }}

serviceAccount:
  annotations:
    {{ .Values.annotations.openproject.serviceAccount | toYaml | nindent 4 }}

ingress:
  annotations:
    nginx.ingress.kubernetes.io/proxy-body-size: {{ .Values.ingress.parameters.bodySize.openproject | quote }}
    nginx.ingress.kubernetes.io/proxy-read-timeout: {{ .Values.ingress.parameters.bodyTimeout.openproject | quote }}
    nginx.ingress.kubernetes.io/proxy-send-timeout: {{ .Values.ingress.parameters.bodyTimeout.openproject | quote }}
    haproxy-ingress.github.io/proxy-body-size: {{ .Values.ingress.parameters.bodySize.openproject | quote }}
    haproxy-ingress.github.io/timeout-server: "{{ .Values.ingress.parameters.bodyTimeout.openproject}}s"
    haproxy-ingress.github.io/timeout-client: "{{ .Values.ingress.parameters.bodyTimeout.openproject}}s"
    {{- with .Values.annotations.openproject.ingress }}
    {{ . | toYaml | nindent 4 }}
    {{- end }}
  host: "{{ .Values.global.hosts.openproject }}.{{ .Values.global.domain }}"
  enabled: {{ .Values.ingress.enabled }}
  ingressClassName: {{ .Values.ingress.ingressClassName | quote }}
  tls:
    enabled: {{ .Values.ingress.tls.enabled }}
    secretName: {{ .Values.ingress.tls.secretName | quote }}

backgroundReplicaCount: {{ .Values.replicas.openprojectWorker }}

replicaCount: {{ .Values.replicas.openprojectWeb }}

resources:
  {{ .Values.resources.openproject | toYaml | nindent 2 }}

s3:
  enabled: true
  directUploads: {{ .Values.objectstores.openproject.directUploads }}
  enableSignatureV4Streaming: {{ .Values.objectstores.openproject.enableSignatureV4Streaming }}
  {{- if .Values.objectstores.openproject.endpoint }}
  endpoint: {{ printf "https://%s" .Values.objectstores.openproject.endpoint | quote }}
  host: {{ printf "https://%s" .Values.objectstores.openproject.endpoint | quote }}
  {{- else if .Values.apps.minio.enabled }}
  endpoint: {{ printf "https://%s.%s" .Values.global.hosts.minioApi .Values.global.domain | quote }}
  host: {{ printf "https://%s" .Values.objectstores.openproject.endpoint | quote }}
  {{- else if .Values.apps.seaweedfs.enabled }}
  endpoint: {{ printf "https://%s.%s" .Values.global.hosts.seaweedfs .Values.global.domain | quote }}
  host: {{ printf "https://%s" .Values.objectstores.openproject.endpoint | quote }}
  {{- else }}
  {{- fail "No objectstorage endpoint for openproject found!" }}
  {{- end }}
  pathStyle: {{ .Values.objectstores.openproject.pathStyle }}
  region: {{ .Values.objectstores.openproject.region | quote }}
  bucketName: {{ .Values.objectstores.openproject.bucket | quote }}
  useIamProfile: {{ .Values.objectstores.openproject.useIamProfile }}
  auth:
    accessKeyId: {{ .Values.objectstores.openproject.username | quote }}
    {{- if .Values.externalSecrets.enabled }}
    # S3 access-key + secret-access-key are injected via `extraEnvVars`
    # against the cluster-side `opendesk-s3-credentials` Secret. Checked first:
    # since 1.17 `secretKey.value` always carries the master-password-derived
    # default, so testing it first would inline that value.
    {{- else if .Values.objectstores.openproject.secretKey.value }}
    secretAccessKey: {{ .Values.objectstores.openproject.secretKey.value | quote }}
    {{- else if or .Values.apps.minio.enabled .Values.apps.seaweedfs.enabled }}
    secretAccessKey: {{ .Values.secrets.minio.openprojectUser | quote }}
    {{- else }}
    {{- fail "No objectstorage secretKey for openproject found!" }}
    {{- end }}

seederJob:
  annotations:
    intents.otterize.com/service-name: "openproject-seeder"
    argocd.argoproj.io/hook: "Sync"
    argocd.argoproj.io/hook-delete-policy: "HookSucceeded"
    {{- with .Values.annotations.openproject.seederJob }}
    {{ . | toYaml | nindent 4 }}
    {{- end }}
  resources:
    {{ .Values.resources.openprojectSeederJob | toYaml | nindent 4 }}

workers:
  default:
    strategy:
      type: "RollingUpdate"
    resources:
      {{ .Values.resources.openprojectWorkers | toYaml | nindent 6 }}

...
