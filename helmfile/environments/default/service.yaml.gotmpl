---
service:
  # Only override when needed, the default is set in `.Values.cluster.service.type` defined in `cluster.yaml.gotmpl`
  type:
    jitsiVideoBridge: ~
    dovecot: ~
    postfix: ~
  # Optional reserved LoadBalancer IPs for the externally-exposed services.
  # Left unset by default (ephemeral cloud-assigned IP); set per-environment
  # from the deployment overlay (e.g. cloud repo) to pin a reserved IP. The
  # consuming Service templates only emit `loadBalancerIP` when a value is set.
  loadBalancerIp:
    jitsiVideoBridge: ~
    dovecot: ~
    postfix: ~
  # Optional externalTrafficPolicy per externally-exposed service. "Local"
  # preserves the client source IP and is required for IONOS LB IP <-> pod
  # co-location (the LB IP is only reachable on a node that also runs the pod).
  # Emitted by the consuming Service template only when set.
  externalTrafficPolicy:
    jitsiVideoBridge: ~
  # Optional pod nodeSelector per component, to co-locate the pod with its LB
  # IP. Emitted by the consuming workload template only when set.
  nodeSelector:
    jitsiVideoBridge: {}
    postfix: {}
...
