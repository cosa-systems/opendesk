---
# This file is the single place a cache and its credential are configured. A `password` carries the
# full value/create/name/key convention documented on `cassandra.rootPassword` in
# `secrets.yaml.gotmpl` only where something is handed the Secret rather than the value - the Redis
# chart and the migrations. The rest are value-only: their charts inline the password, so there is
# nothing to provision a Secret for and a `create`/`name`/`key` there would only suggest a Secret
# reference that no consumer makes.
#
# The per-component `password.value` entries are empty by default: an empty entry means "the
# bundled server's password", and every consumer falls back to `cache.redis.password` for it -
# to its `value`, or to its `name`/`key` where the chart takes a Secret reference.
# Overriding only `cache.redis.password.value` therefore changes the password for the server and
# for every component using it. Pointing a component at an external cache means overriding its
# `host`/`port`/`username`/`tls` **and** its `password.value`; a non-empty component entry wins
# over the fallback in every consumer.

{{- $redisPassword := derivePassword 1 "long" (env "MASTER_PASSWORD") "redis" "password" | sha1sum }}
{{- $notesHost := "redis-headless" }}{{- $notesPort := 6379 }}{{- $notesUser := "default" }}{{- $notesPassword := "" }}{{- $notesTls := false }}
cache:
  redis:
    # The password the bundled Redis is deployed with, referenced by `auth.existingSecret` in the Redis chart.
    password:
      # A non-empty MASTER_PASSWORD is enforced in `secrets.yaml.gotmpl`, which every helmfile run
      # renders alongside this file.
      value: {{ derivePassword 1 "long" (env "MASTER_PASSWORD") "redis" "password" | sha1sum | quote }}
      create: true
      name: "redis-password"
      key: "redis-password"
  intercomService:
    host: "redis-headless"
    port: 6379
    # Username is currently being ignored by the Intercom Service Helm chart.
    # Ref.: https://forge.univention.org/bugzilla/show_bug.cgi?id=59490
    username: "default"
    # Read from a Secret by both consumers: the Intercom Service release
    # (`ics.redis.auth.existingSecret`) and the `flush_intercom_sessions` migration. The Secret
    # below carries the *override* only: while `value` is empty, both point at the bundled
    # server's `redis-password` Secret instead (see `opendesk-migrations-post/values.yaml.gotmpl`),
    # so both stay a plain reflection of what this file states.
    password:
      value: ""
      create: true
      name: "cache-intercom-service-password"
      key: "password"
    tls: false
  nextcloud:
    host: "redis-headless"
    port: 6379
    username: "default"
    # Empty by default: the Nextcloud releases then read the bundled server's credential from its
    # Secret (`cache.redis.password` name/key). A non-empty value here wins, as everywhere else, and
    # is inlined into the chart configuration.
    password:
      value: ""
    tls: false
  notes:
    host: {{ $notesHost | quote }}
    port: {{ $notesPort }}
    username: {{ $notesUser | quote }}
    # An empty value means the shared Redis password (`cache.redis.password`); the URL below
    # applies the same fallback.
    password:
      value: {{ $notesPassword | quote }}
    tls: {{ $notesTls }}
    # The connection URL the Notes backend takes as one string, password included. Composed from
    # the fields above (the password falls back to the shared Redis one) so there is one source
    # of truth; delivered as a Secret because the URL is the credential.
    redisUrl:
      value: {{ printf "redis%s://%s:%s@%s:%v/7" (ternary "s" "" $notesTls) $notesUser (default $redisPassword $notesPassword) $notesHost $notesPort | quote }}
      create: true
      name: "cache-notes-redis-url"
      key: "url"
  openproject:
    host: "memcached"
    port: 11211
  oxAppSuite:
    host: "redis-headless"
    port: 6379
    username: "default"
    # Value-only: OX App Suite inlines the password into its properties.
    password:
      value: ""
    tls: false
  umsSelfservice:
    host: "memcached"
    port: 11211
...
