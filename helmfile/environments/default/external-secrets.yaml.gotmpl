---
# Downstream carry (cosa-systems), not upstream: the OX App Suite charts take their credentials
# only as whole documents - `existingPropertiesSecret`, `existingETCFilesSecret`,
# `existingYAMLFilesSecret`, `redis.existingSecret`, `mysql.existingSecret`, core-mw's
# `existingEnvSecret` - so the per-credential {value, create, name, key} convention cannot reach
# them. When `OPENDESK_EXTERNAL_SECRETS=true`, the OX glue in helmfile/apps/open-xchange/ points
# those options at cluster-side Secrets provisioned out of band (`opendesk-ox-existing-*`,
# `<name>` below for core-mw's env) instead of inlining the values. Nothing else reads this file.
externalSecrets:
  enabled: {{ eq (env "OPENDESK_EXTERNAL_SECRETS") "true" }}
  name: {{ env "OPENDESK_EXTERNAL_SECRETS_NAME" | default "" | quote }}
  # Per-component Postgres passwords are NOT in the consolidated secret
  # above. The cluster's db-bootstrap job creates each role with the value
  # in `db-passwords` under key `PG_<COMPONENT>`, so every chart must read
  # its DB password from that same Secret/key — otherwise the chart connects
  # with a different value than the role was created with and auth fails.
  # Overridable via OPENDESK_EXTERNAL_SECRETS_DB_NAME; defaults to db-passwords.
  dbSecretName: {{ env "OPENDESK_EXTERNAL_SECRETS_DB_NAME" | default "db-passwords" | quote }}
