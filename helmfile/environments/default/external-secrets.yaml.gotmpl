---
# When `OPENDESK_EXTERNAL_SECRETS=true`, per-app glue files emit
# `existingSecret`/`secretKeyRef` references to a cluster-side Secret
# named via `OPENDESK_EXTERNAL_SECRETS_NAME` instead of baking
# MASTER_PASSWORD-derived credentials inline. `secrets.yaml.gotmpl`
# reads the same env var directly (helmfile templates each env-values
# file in isolation, so per-app glue uses `.Values` while
# `secrets.yaml.gotmpl` uses the env directly).
externalSecrets:
  enabled: {{ eq (env "OPENDESK_EXTERNAL_SECRETS") "true" }}
  name: {{ env "OPENDESK_EXTERNAL_SECRETS_NAME" | default "" | quote }}
  # Per-component Postgres passwords are NOT in the consolidated secret
  # above. The cluster's db-bootstrap job creates each role with the value
  # in `db-passwords` under key `PG_<COMPONENT>`, so every chart must read
  # its DB password from that same Secret/key — otherwise the chart connects
  # with a different value than the role was created with and auth fails.
  # Overridable via OPENDESK_EXTERNAL_SECRETS_DB_NAME; defaults to db-passwords.
  dbSecretName: {{ env "OPENDESK_EXTERNAL_SECRETS_DB_NAME" | default "db-passwords" | quote }}
