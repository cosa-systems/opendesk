---
{{- $masterPassword := required "A non-empty MASTER_PASSWORD is required!" (env "MASTER_PASSWORD") }}
secrets:
  cassandra:
    rootPassword:
      value: {{ derivePassword 1 "long" $masterPassword "cassandra" "root_password" | sha1sum | quote }}
      # value/create/name/key convention: this secret is always delivered to the consuming
      # chart as a Kubernetes Secret named `name` with key `key` (via the chart's
      # `existingSecret`) - the value is never inlined into the chart.
      #   create: true  (default) -> openDesk provisions that Secret from `value` via the
      #                              opendesk-secrets chart (auto-deployed whenever at least
      #                              one secret is create: true).
      #   create: false           -> bring your own: a Secret named `name` (key `key`) must
      #                              already exist; opendesk-secrets leaves it untouched.
      # The Bitnami Cassandra chart consumes it via dbUser.existingSecret.
      create: true
      name: "cassandra-root-password"
      key: "cassandra-password"
  oxAppSuite:
    # Mostly value-only: the OX App Suite charts cannot read most of these from a Secret.
    # adminPassword/basicAuthPassword/jolokiaPassword can only be supplied through core-mw's
    # all-or-nothing "secret-envvars" Secret (not per-field name/key) - deferred. The salts, crypt
    # keys, oxguard material and tokens are inlined into OX properties/ETC config (no secret
    # indirection); hzGroupPassword is unused by the chart. The exceptions carry create/name/key
    # for the *other* consumers that can read a Secret (migrations, Dovecot); OX itself keeps
    # receiving their `value`.
    adminPassword:
      value: {{ derivePassword 1 "long" $masterPassword "ox_appsuite" "admin_password" | sha1sum | quote }}
      # The exception: this one *is* rendered as a Kubernetes Secret, not for the OX App Suite
      # charts - which keep receiving the value above - but for the automated migrations. They
      # provision through the same SOAP API and with the same master administrator the OX Connector
      # uses, and a migration Job reads its credentials from mounted Secrets only, never from a
      # templated value. Set `create: false` and name your own Secret to bring your own.
      create: true
      name: "opendesk-ox-admin-password"
      key: "password"
    basicAuthPassword:
      value: {{ derivePassword 1 "long" $masterPassword "ox_appsuite" "basic_auth_password" | sha1sum | quote }}
    cookieHashSalt:
      value: {{ derivePassword 1 "long" $masterPassword "ox_appsuite" "cookie_hash_salt" | sha1sum | quote }}
    hzGroupPassword:
      value: {{ derivePassword 1 "long" $masterPassword "ox_appsuite" "hz_group_password" | sha1sum | quote }}
    jolokiaPassword:
      value: {{ derivePassword 1 "long" $masterPassword "ox_appsuite" "jolokia_password" | sha1sum | quote }}
    migrationsMasterPassword:
      value: {{ derivePassword 1 "long" (env "MASTER_PASSWORD" | default "opendesk") "ox_appsuite" "migrations_master_password" | sha1sum | quote }}
      # Delivered as a Secret for Dovecot's mail migration (dovecot chart `migration.masterPassword`).
      # create: false is client-limited here: OX App Suite still reads the value literally.
      create: true
      name: "opendesk-ox-migrations-master-password"
      key: "password"
    oxguardMC:
      value: {{ printf "MC%s" (derivePassword 1 "long" $masterPassword "ox_appsuite" "oxguardMC" | sha1sum | trunc 20 | b64enc) | quote }}
    oxguardRC:
      value: {{ printf "RC%s" (derivePassword 1 "long" $masterPassword "ox_appsuite" "oxguardRC" | sha1sum | trunc 20 | b64enc) | quote }}
    restApiPassword:
      value: {{ derivePassword 1 "long" $masterPassword "ox_appsuite" "rest_api_password" | sha1sum | quote }}
      # Delivered as a Secret for Dovecot (dovecot chart `oxApi.password`). create: false is
      # client-limited here: OX App Suite still reads the value literally.
      create: true
      name: "opendesk-ox-rest-api-password"
      key: "password"
    sessiondEncryptionKey:
      value: {{ derivePassword 1 "long" $masterPassword "ox_appsuite" "sessiond_encryption_key" | sha1sum | quote }}
    shareCryptKey:
      value: {{ derivePassword 1 "long" $masterPassword "ox_appsuite" "share_crypt_key" | sha1sum | quote }}
    # A second exception: Synapse reads this from the managed Secret for the ox-appsuite
    # appservice registration. The OX side still consumes `.value` - it is inlined into the OX
    # properties as `com.openexchange.conference.element.authToken`, which has no Secret
    # reference. Both stay in sync as long as `create: true` (same value).
    synapseAsToken:
      value: {{ derivePassword 1 "long" $masterPassword "ox_appsuite" "as_token" | sha1sum | quote }}
      create: true
      name: "ox-appsuite-synapse-as-token"
      key: "token"
  oxConnector:
    provisioningApiPassword:
      value: {{ derivePassword 1 "long" $masterPassword "nubus" "ox-connector" | sha1sum | quote }}
      create: true
      name: "ox-connector-provisioning-api-password"
      key: "password"
  postfix:
    opendeskSystemPassword:
      value: {{ derivePassword 1 "long" $masterPassword "postfix" "opendesk-system" | sha1sum | quote }}
      create: true
      name: "postfix-opendesk-system-password"
      key: "password"
      extraData:
        # OpenProject consumes this shared Secret via envFrom (openproject.extraEnvVarsSecret), which
        # turns each data key into an env var name - so it needs OpenProject's own key too (same value).
        OPENPROJECT_SMTP__PASSWORD: {{ derivePassword 1 "long" $masterPassword "postfix" "opendesk-system" | sha1sum | quote }}
      # Consumed from this Secret (existingSecret / secretKeyRef) by:
      # - XWiki (javaOptsSecrets)
      # - Nextcloud (smtp.auth.password.secret, key `password`)
      # - Notes (configuration.email.password.existingSecret, key `password`)
      # - OpenProject (extraEnvVarsSecret -> envFrom, via the OPENPROJECT_SMTP__PASSWORD key above)
      # - Nubus keycloak-extensions (existingSecret keyMapping, to a nubus-managed Secret)
      # Still read literally (their charts expose no existingSecret for SMTP), so create: false stays
      # client-limited for:
      # - Synapse (inlined into the homeserver.yaml ConfigMap - plaintext - changes when upstream chart integration is done)
      # - OX (secretPropertiesFiles - the chart builds its own Secret from the value)
      # - Nubus umc-server
  nubus:
    # Value-only: the master seed used to derive the other nubus passwords; not a referenceable Secret.
    masterpassword:
      value: {{ $masterPassword | quote }}
    # The LDAP cn=admin password. The ldap-server subchart reads it from this Secret
    # (ldapServer.auth.existingSecret) instead of materialising its own
    # "ums-ldap-server-admin", and every UMS component that binds as cn=admin is pointed
    # here through the umbrella-global `global.ldap.auth.admin.existingSecret` - see
    # values-nubus.yaml.gotmpl.
    ldapSecret:
      value: {{ derivePassword 1 "long" $masterPassword "cn=admin" "ldap" | sha1sum | quote }}
      create: true
      name: "nubus-ldap-admin-password"
      key: "password"
    # All entries are rendered inline as LDAP bind users (stack-data-ums templateContext). Entries whose
    # consuming release can read the password from a Secret carry `create`/`name`/`key` in addition.
    ldapSearch:
      # Externalized for the Keycloak bootstrap, which binds as uid=ldapsearch_keycloak to
      # configure the LDAP user federation. Same caveat as the XWiki entry below: the
      # stack-data-ums LDAP-user creation (values-nubus.yaml.gotmpl `ldapSearchUsers`, which
      # iterates this whole block) still consumes `.value` inline, so both stay in sync as
      # long as `create: true`.
      keycloak:
        value: {{ derivePassword 1 "long" $masterPassword "nubus" "ldapsearch_keycloak" | sha1sum | quote }}
        create: true
        name: "nubus-ldap-keycloak-bind"
        key: "password"
      # Externalized for the Nextcloud management release, which reads it from the managed Secret.
      # The stack-data-ums LDAP-user creation (values-nubus.yaml.gotmpl `ldapSearchUsers`) still
      # consumes `.value` inline; both stay in sync as long as `create: true`.
      nextcloud:
        value: {{ derivePassword 1 "long" $masterPassword "nubus" "ldapsearch_nextcloud" | sha1sum | quote }}
        create: true
        name: "nubus-ldap-nextcloud-bind"
        key: "password"
      # Externalized for Dovecot, which reads it from the managed Secret; the stack-data-ums
      # LDAP-user creation (values-nubus.yaml.gotmpl `ldapSearchUsers`) still consumes `.value`
      # inline. Both stay in sync as long as `create: true`.
      dovecot:
        value: {{ derivePassword 1 "long" $masterPassword "nubus" "ldapsearch_dovecot" | sha1sum | quote }}
        create: true
        name: "nubus-ldap-dovecot-bind"
        key: "password"
      # Externalized for the Element releases.
      # opendesk-synapse-admin and opendesk-synapse-groupsync read it from the managed Secret;
      # the stack-data-ums LDAP-user creation (values-nubus.yaml.gotmpl `ldapSearchUsers`) still
      # consumes `.value` inline. Both stay in sync as long as `create: true`.
      element:
        value: {{ derivePassword 1 "long" $masterPassword "nubus" "ldapsearch_element" | sha1sum | quote }}
        create: true
        name: "nubus-ldap-element-bind"
        key: "password"
      ox:
        value: {{ derivePassword 1 "long" $masterPassword "nubus" "ldapsearch_ox" | sha1sum | quote }}
      # Externalized for Postfix. Both Postfix releases read it from the managed Secret, for the bind
      # itself and for every LDAP map (the chart falls back to this Secret for maps without a password
      # of their own); the stack-data-ums LDAP-user creation (values-nubus.yaml.gotmpl
      # `ldapSearchUsers`) still consumes `.value` inline. Both stay in sync as long as `create: true`.
      postfix:
        value: {{ derivePassword 1 "long" $masterPassword "nubus" "ldapsearch_postfix" | sha1sum | quote }}
        create: true
        name: "nubus-ldap-postfix-bind"
        key: "password"
      # Externalized for OpenProject, which reads it from the managed Secret. The stack-data-ums
      # LDAP-user creation (values-nubus.yaml.gotmpl `ldapSearchUsers`) still consumes `.value`
      # inline; both stay in sync as long as `create: true`, and a bring-your-own Secret has to carry
      # that same value.
      openproject:
        value: {{ derivePassword 1 "long" $masterPassword "nubus" "ldapsearch_openproject" | sha1sum | quote }}
        create: true
        name: "nubus-ldap-openproject-bind"
        key: "password"
      # Externalized for XWiki.
      # The XWiki release reads it from the managed Secret; the stack-data-ums LDAP-user creation
      # (values-nubus.yaml.gotmpl `ldapSearchUsers`) still consumes `.value` inline. Both stay in
      # sync as long as `create: true` (they derive from the same value).
      xwiki:
        value: {{ derivePassword 1 "long" $masterPassword "nubus" "ldapsearch_xwiki" | sha1sum | quote }}
        create: true
        name: "nubus-ldap-xwiki-bind"
        key: "password"
    systemAccounts:
      # The initial password of the IAM "Administrator" account. The stack-data-ums data
      # loader takes it from this Secret at Job runtime (`nubusStackDataUms.contextUsers`
      # in values-nubus.yaml.gotmpl), so the chart writes it neither into its own
      # <release>-stack-data-ums-administrator Secret nor into the rendered
      # <release>-context Secret. It is the only copy of the password in the
      # deployment and the one getting-started.md documents for retrieving it.
      administratorPassword:
        value: {{ derivePassword 1 "long" $masterPassword "nubus" "Administrator" | sha1sum | quote }}
        create: true
        name: "nubus-administrator-password"
        key: "password"
      # The password of the "svc-portal-server" service account, which portal-frontend,
      # portal-consumer and portal-server use to authenticate with the UDM REST API.
      # Read from this Secret by the same contextUsers mechanism as the Administrator
      # password above, and by the three components through their `udm.auth.existingSecret`
      # in values-nubus.yaml.gotmpl.
      #
      # This value was previously generated by the stack-data-ums chart, which openDesk
      # supplied nothing for. It is reproduced here exactly, so that taking the password
      # over does not rotate it on an existing deployment: the chart declares the inputs
      # as `contextUsers.svcPortalServer.derivation` (username `svc-portal-server`, site
      # `nubus`), and generates `derivePassword 1 long <masterPassword> <username> <site>
      # | sha1sum` from them. The arguments below mirror those values, so a change to
      # them upstream is visible as a values change rather than a silent divergence.
      svcPortalServerPassword:
        value: {{ derivePassword 1 "long" $masterPassword "svc-portal-server" "nubus" | sha1sum | quote }}
        create: true
        name: "nubus-svc-portal-server-password"
        key: "password"
    # The service-to-service passwords of the provisioning stack. Every one of them is read
    # from its Secret through the matching component's existingSecret/keyMapping - see
    # values-nubus.yaml.gotmpl - so nothing inlines them any more. They stay auto-derived by
    # default like every other credential; `create: false` lets an operator supply any of them
    # from an external secret manager instead.
    # The two provisioning consumers read their password from these Secrets, and the
    # register-consumers Job is pointed at the same ones through `passwordSecret` - so the
    # credential is not written into the registration document the Job posts.
    portalConsumer:
      # Value-only, and not for lack of a knob: the component's chart takes an
      # existingSecret, but its Secret carries the register-consumers `registration`
      # document alongside the password, and the chart skips the whole Secret once the
      # password is externalized - taking the registration with it. Externalizing this
      # needs the chart to keep rendering the keys that are not externalized first.
      provisioningApiPassword:
        value: {{ derivePassword 1 "long" $masterPassword "portal-consumer" "provisioning-api" | sha1sum | quote }}
        create: true
        name: "portal-consumer-provisioning-api-password"
        key: "password"
    selfserviceConsumer:
      # Value-only, and not for lack of a knob: the component's chart takes an
      # existingSecret, but its Secret carries the register-consumers `registration`
      # document alongside the password, and the chart skips the whole Secret once the
      # password is externalized - taking the registration with it. Externalizing this
      # needs the chart to keep rendering the keys that are not externalized first.
      provisioningApiPassword:
        value: {{ derivePassword 1 "long" $masterPassword "selfservice-consumer" "provisioning-api" | sha1sum | quote }}
        create: true
        name: "selfservice-consumer-provisioning-api-password"
        key: "password"
    provisioning:
      api:
        adminPassword:
          value: {{ derivePassword 1 "long" $masterPassword "api" "admin_api" | sha1sum | quote }}
          create: true
          name: "nubus-provisioning-api-admin-password"
          key: "password"
        # prefix `nats` passwords with `n` because of an upstream bug, for further information see https://gitlab.opencode.de/bmi/opendesk/deployment/opendesk/-/blob/main/docs/getting-started.md?ref_type=heads#password-seed
        natsPassword:
          value: {{ printf "n%s" (derivePassword 1 "long" $masterPassword "api" "nats" | sha1sum) | quote }}
          create: true
          name: "nubus-provisioning-api-nats-password"
          key: "password"
        prefillPassword:
          value: {{ derivePassword 1 "long" $masterPassword "prefill" "prefill_service" | sha1sum | quote }}
          create: true
          name: "nubus-provisioning-api-prefill-password"
          key: "password"
        udmTransformerPassword:
          value: {{ derivePassword 1 "long" $masterPassword "udmproducer" "events_api" | sha1sum | quote }}
          create: true
          name: "nubus-provisioning-api-udm-transformer-password"
          key: "password"
      dispatcherNatsPassword:
        value: {{ printf "n%s" (derivePassword 1 "long" $masterPassword "dispatcher" "nats" | sha1sum) | quote }}
        create: true
        name: "nubus-provisioning-dispatcher-nats-password"
        key: "password"
      prefillNatsPassword:
        value: {{ printf "n%s" (derivePassword 1 "long" $masterPassword "prefill" "nats" | sha1sum) | quote }}
        create: true
        name: "nubus-provisioning-prefill-nats-password"
        key: "password"
      udmListenerNatsPassword:
        value: {{ printf "n%s" (derivePassword 1 "long" $masterPassword "udmListener" "nats" | sha1sum) | quote }}
        create: true
        name: "nubus-provisioning-udm-listener-nats-password"
        key: "password"
      udmTransformerNatsPassword:
        value: {{ printf "n%s" (derivePassword 1 "long" $masterPassword "udmTransformer" "nats" | sha1sum) | quote }}
        create: true
        name: "nubus-provisioning-udm-transformer-nats-password"
        key: "password"
  nats:
    # Read by the bundled NATS subchart through
    # `nats.config.createUsers.adminUser.auth.existingSecret`, which takes precedence over the
    # inline password.
    natsAdminPassword:
      value: {{ printf "n%s" (derivePassword 1 "long" $masterPassword "admin" "nats" | sha1sum) | quote }}
      create: true
      name: "nats-admin-password"
      key: "password"
  postgresql:
    # The bundled PostgreSQL's superuser password, read from this Secret by the server and by
    # its bootstrap Job (`postgres.existingSecret`) - the same shape `mariadb.rootPassword`
    # already uses for the bundled MariaDB.
    postgresUser:
      value: {{ derivePassword 1 "long" $masterPassword "postgres" "postgres_user" | sha1sum | quote }}
      create: true
      name: "postgresql-root-password"
      key: "password"
  mariadb:
    rootPassword:
      value: {{ derivePassword 1 "long" $masterPassword "mariadb" "root_password" | sha1sum | quote }}
      create: true
      name: "mariadb-root-password"
      key: "rootPassword"
      # create: false is client-limited here: this value is also read literally by
      # OX (DB root connection), which cannot source it from the Secret.
      # Keep create: true unless that is handled too. XWiki reads it through
      # the chart's `externalDB.customKeyRef`, so it no longer needs the value.
    # The OX App Suite database user, created by the bundled MariaDB's bootstrap Job.
    openxchangeUser:
      value: {{ derivePassword 1 "long" $masterPassword "mariadb" "openxchange_user" | sha1sum | quote }}
      create: true
      name: "mariadb-openxchange-user-password"
      key: "password"
  # In order to keep make migration from MinIO to SeaweedFS easier, MinIO credentials are reused for SeaweedFS
  # However, with the removal of MinIO in the openDesk 2.0 release, this configuration will be renamed to `objectstorage`
  minio:
    rootPassword:
      value: {{ (derivePassword 1 "long" $masterPassword "minio" "root_password" | sha1sum | quote) }}
      # See the value/create/name/key convention on `cassandra.rootPassword`.
      # The Bitnami MinIO chart (auth.existingSecret) reads BOTH user and password from this
      # Secret: `key` is the password key; the root user is stored under the fixed key
      # `root-user` (chart default) via `extraData` below - a bring-your-own Secret
      # (create: false) must contain `root-user` too. Other consumers (e.g. SeaweedFS config)
      # read `.value` directly, so `create: false` only works if no consumer still needs the
      # literal value.
      create: true
      name: "minio-root-password"
      key: "root-password"
      extraData:
        root-user: "admin"
  keycloak:
    adminPassword:
      value: {{ derivePassword 1 "long" $masterPassword "keycloak" "adminPassword" | sha1sum | quote }}
      create: true
      name: "keycloak-admin-password"
      key: "adminPassword"
    # OIDC client secrets. Each externalized entry (create/name/key) is delivered as a managed
    # Kubernetes Secret and consumed on BOTH sides from it: the keycloak-bootstrap client
    # registration (values-opendesk-keycloak-bootstrap.yaml.gotmpl, via `secret.existingSecret`)
    # and the app itself (its chart's OIDC existingSecret). Both point at the same Secret/key, so
    # registration and login stay in sync.
    clientSecret:
      dovecot:
        value: {{ derivePassword 1 "long" $masterPassword "keycloak" "dovecot_client_secret" | sha1sum | quote }}
        create: true
        name: "keycloak-client-secret-dovecot"
        key: "secret"
      dovecotGrant:
        value: {{ derivePassword 1 "long" $masterPassword "keycloak" "dovecot_grant_client_secret" | sha1sum | quote }}
        create: true
        name: "keycloak-grant-client-secret-dovecot"
        key: "secret"
      intercom:
        value: {{ derivePassword 1 "long" $masterPassword "keycloak" "intercom_client_secret" | sha1sum | quote }}
        create: true
        name: "keycloak-client-secret-intercom"
        key: "secret"
      matrix:
        value: {{ derivePassword 1 "long" $masterPassword "keycloak" "matrix_client_secret" | sha1sum | quote }}
        create: true
        name: "keycloak-client-secret-matrix"
        key: "secret"
      ncoidc:
        value: {{ derivePassword 1 "long" $masterPassword "keycloak" "ncoidc_client_secret" | sha1sum | quote }}
        create: true
        name: "keycloak-client-secret-ncoidc"
        key: "secret"
      openproject:
        value: {{ derivePassword 1 "long" $masterPassword "keycloak" "openproject_client_secret" | sha1sum | quote }}
        create: true
        name: "keycloak-client-secret-openproject"
        key: "secret"
      xwiki:
        value: {{ derivePassword 1 "long" $masterPassword "keycloak" "xwiki_client_secret" | sha1sum | quote }}
        create: true
        name: "keycloak-client-secret-xwiki"
        key: "secret"
      as8oidc:
        value: {{ derivePassword 1 "long" $masterPassword "keycloak" "as8oidc_client_secret" | sha1sum | quote }}
        create: true
        name: "keycloak-client-secret-as8oidc"
        key: "secret"
      notes:
        value: {{ derivePassword 1 "long" $masterPassword "keycloak" "notes_client_secret" | sha1sum | quote }}
        create: true
        name: "keycloak-client-secret-notes"
        key: "secret"
  nextcloud:
    adminPassword:
      value: {{ derivePassword 1 "long" $masterPassword "nextcloud" "nextcloud_admin_user" | sha1sum | quote }}
      create: true
      name: "nextcloud-admin-password"
      key: "password"
    metricsToken:
      value: {{ derivePassword 1 "long" $masterPassword "nextcloud" "metricsToken" | sha1sum | quote }}
      create: true
      name: "nextcloud-metrics-token"
      key: "token"
    statusPassword:
      value: {{ derivePassword 1 "medium" $masterPassword "nextcloud" "nextcloud_status_user" | sha1sum | quote }}
      create: true
      name: "nextcloud-status-password"
      key: "password"
  openproject:
    adminPassword:
      value: {{ derivePassword 1 "long" $masterPassword "openproject" "openproject_admin_user" | sha1sum | quote }}
      create: true
      name: "openproject-admin-password"
      key: "password"
    # Rails' SECRET_KEY_BASE, used to sign and encrypt session cookies. Without this entry the chart
    # generates one at random on first install and keeps it through a `lookup`, which means it is not
    # derived from the master password, not reproducible when a deployment is rebuilt, and different in
    # every rendered manifest. Delivered as a Secret like every other credential instead. Set
    # `create: false` and name your own Secret to bring your own - existing deployments keep their
    # current key that way, see `migrations-manual.md`.
    secretKeyBase:
      value: {{ derivePassword 1 "long" $masterPassword "openproject" "openproject_secret_key_base" | sha256sum | quote }}
      create: true
      name: "openproject-secret-key-base"
      key: "secret-key-base"
    # The shared secret between OpenProject and the collaborative-editing (hocuspocus) backend, which
    # the chart otherwise generates at random the same way as the key base above.
    hocuspocusSecret:
      value: {{ derivePassword 1 "long" $masterPassword "openproject" "openproject_hocuspocus_secret" | sha1sum | quote }}
      create: true
      name: "openproject-hocuspocus-secret"
      key: "secret"
    # The basic-auth credentials of the API admin user, read from these Secrets by the OpenProject
    # release (`extraEnvVars`) and by the bootstrap Job (`config.openproject.admin.*.secret`).
    apiAdminUsername:
      value: {{ derivePassword 1 "long" $masterPassword "openproject" "openproject_api_admin_username" | sha1sum | quote }}
      create: true
      name: "openproject-api-admin-username"
      key: "username"
    apiAdminPassword:
      value: {{ derivePassword 1 "long" $masterPassword "openproject" "openproject_api_admin_password" | sha1sum | quote }}
      create: true
      name: "openproject-api-admin-password"
      key: "password"
  collabora:
    adminPassword:
      value: {{ derivePassword 1 "long" $masterPassword "collabora" "collabora_admin_user" | sha1sum | quote }}
      create: true
      name: "collabora-admin-password"
      # `key` is the password key. The Collabora chart also reads the admin username from
      # this same Secret under the fixed key `username` (its default usernameKey, which this
      # wiring does not override). It is stored via `extraData` below, so a bring-your-own
      # Secret (create: false) must also contain a `username` key.
      key: "password"
      extraData:
        username: "collabora-internal-admin"
  jitsi:
    # All Jitsi secrets are delivered to the upstream jitsi-meet chart as EXISTING Kubernetes Secrets
    # via its per-component `existingSecretName` options (see values-jitsi.yaml.gotmpl). The chart loads
    # each Secret with `envFrom`, so the data KEY must be the exact env-var name the container expects
    # (JWT_APP_SECRET, JVB_AUTH_PASSWORD, ...); the non-secret XMPP user names ride along as `extraData`.
    jwtAppSecret:
      value: {{ derivePassword 1 "long" $masterPassword "jistiStandalone" "jwtAppSecret" | sha1sum | quote }}
      create: true
      name: "jitsi-jwt-app-secret"
      key: "JWT_APP_SECRET"
      # Consumed from this Secret by BOTH the opendesk-jitsi keycloak-adapter (secretKeyRef) and the
      # upstream prosody (prosody.jwt.existingSecretName -> envFrom JWT_APP_SECRET). No literal consumer
      # remains, so create: false (bring your own) is now possible.
    jicofoAuthPassword:
      value: {{ derivePassword 1 "long" $masterPassword "jistiStandalone" "jicofoAuthPassword" | sha1sum | quote }}
      create: true
      name: "jitsi-jicofo-auth"
      key: "JICOFO_AUTH_PASSWORD"
    jvbAuthPassword:
      value: {{ derivePassword 1 "long" $masterPassword "jistiStandalone" "jvbAuthPassword" | sha1sum | quote }}
      create: true
      name: "jitsi-jvb-auth"
      key: "JVB_AUTH_PASSWORD"
      extraData:
        JVB_AUTH_USER: "jvb"
    jibriXmppPassword:
      value: {{ derivePassword 1 "long" $masterPassword "jistiStandalone" "jibriXmppPassword" | sha1sum | quote }}
      create: true
      name: "jitsi-jibri-xmpp"
      key: "JIBRI_XMPP_PASSWORD"
      extraData:
        JIBRI_XMPP_USER: "jibri"
    jibriRecorderPassword:
      value: {{ derivePassword 1 "long" $masterPassword "jistiStandalone" "jibriRecorderPassword" | sha1sum | quote }}
      create: true
      name: "jitsi-jibri-recorder"
      key: "JIBRI_RECORDER_PASSWORD"
      extraData:
        JIBRI_RECORDER_USER: "recorder"
    jigasiXmppPassword:
      value: {{ derivePassword 1 "long" $masterPassword "jistiStandalone" "jigasiXmppPassword" | sha1sum | quote }}
      create: true
      name: "jitsi-jigasi-xmpp"
      key: "JIGASI_XMPP_PASSWORD"
      extraData:
        JIGASI_XMPP_USER: "jigasi"
  whiteboard:
    # Value-only: not referenced by any deployed chart.
    apiKey:
      value: {{ derivePassword 1 "long" $masterPassword "whiteboard" "apiKey" | sha1sum | quote }}
  centralnavigation:
    # Externalized for XWiki (chart >= 1.6.8 consumes it via customConfigsSecrets/existingSecret,
    # property `workplaceServices.portalSecret`) and for the Nextcloud management release. Shared
    # credential: those releases read it from the managed Secret, while the other consumers
    # (intercom-service, openproject, nubus) still read `.value` inline - all use the same derived value.
    apiKey:
      value: {{ derivePassword 1 "long" $masterPassword "centralnavigation" "api_key" | sha1sum | quote }}
      create: true
      name: "centralnavigation-api-key"
      key: "apiKey"
  dovecot:
    doveadm:
      value: {{ derivePassword 1 "long" $masterPassword "dovecot" "doveadm" | sha1sum | quote }}
      create: true
      name: "dovecot-doveadm-password"
      key: "password"
      # create: false is client-limited here: this value is also read literally by
      # OX (doveadm apiSecret, config-inlined),
      # which cannot source it from the Secret. Keep create: true unless those are handled too.
    # Read by the Dovecot Pro shared-mailboxes feature through the chart's
    # `pro.sharedMailboxes.masterPassword.existingSecret`, which only the enterprise overlay
    # (values-dovecot-enterprise.yaml.gotmpl) enables - so the Secret is only provisioned for
    # enterprise deployments; nothing references it in the community build.
    sharedMailboxesMasterPassword:
      value: {{ derivePassword 1 "long" $masterPassword "dovecot" "sharedMailboxesMasterPassword" | sha1sum | quote }}
      create: {{ if eq (env "OPENDESK_ENTERPRISE") "true" }}true{{ else }}false{{ end }}
      name: "dovecot-shared-mailboxes-master-password"
      key: "password"
  xwiki:
    # Externalized for XWiki
    # NOTE: XWiki only wires this in when `debug.enabled` is set (see values.yaml.gotmpl); in a
    # normal deployment the managed Secret is created but not consumed.
    superadminpassword:
      value: {{ derivePassword 1 "long" $masterPassword "xwiki" "superadminpassword" | sha1sum | quote }}
      create: true
      name: "xwiki-superadmin-password"
      key: "password"
  intercom:
    secret:
      value: {{ derivePassword 1 "long" $masterPassword "intercom" "secret" | sha1sum | quote }}
      create: true
      name: "intercom-session-secret"
      key: "secret"
    # The intercom-service release reads this from the managed Secret
    # (ics.matrix.auth.existingSecret). The Synapse side still consumes `.value`: the token is
    # inlined into the appservice registration, for which the opendesk-synapse chart has no
    # Secret reference yet. Both stay in sync as long as `create: true` (same value).
    synapseAsToken:
      value: {{ derivePassword 1 "long" $masterPassword "intercom" "as_token" | sha1sum | quote }}
      create: true
      name: "intercom-synapse-as-token"
      key: "token"
  # Every entry below is read from its managed Secret by the Element charts: bot passwords
  # through opendesk-synapse-create-account's `passwordExistingSecret`, appservice tokens
  # through opendesk-synapse's `appServiceConfigs[].tokenExistingSecret` and the bot pipe's
  # `asTokenExistingSecret`/`hsTokenExistingSecret`, backup passphrases through
  # opendesk-synapse-admin's `backupPhraseExistingSecret`.
  matrixAdminBot:
    backupPassphrase:
      value: {{ derivePassword 1 "long" $masterPassword "matrix-admin-bot" "backupPassphrase" | sha1sum | quote }}
      create: true
      name: "matrix-adminbot-backup-passphrase"
      key: "password"
    password:
      value: {{ derivePassword 1 "long" $masterPassword "matrix-admin-bot" "password" | sha1sum | quote }}
      create: true
      name: "matrix-adminbot-password"
      key: "password"
    synapseAsToken:
      value: {{ derivePassword 1 "long" $masterPassword "matrix-admin-bot" "as_token" | sha1sum | quote }}
      create: true
      name: "matrix-adminbot-as-token"
      key: "token"
  matrixAuditBot:
    backupPassphrase:
      value: {{ derivePassword 1 "long" $masterPassword "matrix-auditbot-bot" "backupPassphrase" | sha1sum | quote }}
      create: true
      name: "matrix-auditbot-backup-passphrase"
      key: "password"
    password:
      value: {{ derivePassword 1 "long" $masterPassword "matrix-auditbot-bot" "password" | sha1sum | quote }}
      create: true
      name: "matrix-auditbot-password"
      key: "password"
    synapseAsToken:
      value: {{ derivePassword 1 "long" $masterPassword "matrix-audit-bot" "as_token" | sha1sum | quote }}
      create: true
      name: "matrix-auditbot-as-token"
      key: "token"
  matrixGroupsync:
    synapseAsToken:
      value: {{ derivePassword 1 "long" $masterPassword "matrix-groupsync" "as_token" | sha1sum | quote }}
      create: true
      name: "matrix-groupsync-as-token"
      key: "token"
  matrixNeoDateFixBot:
    password:
      value: {{ derivePassword 1 "long" $masterPassword "matrix-neodatefix-bot" "password" | sha1sum | quote }}
      create: true
      name: "matrix-neodatefix-bot-password"
      key: "password"
  matrixUserVerificationService:
    password:
      value: {{ derivePassword 1 "long" $masterPassword "matrix-user-verification-service" "password" | sha1sum | quote }}
      create: true
      name: "matrix-user-verification-service-password"
      key: "password"
  synapse:
    # Read from the managed Secret by both consumers: Synapse loads it from
    # `registration_shared_secret_path` and the group-sync release from its own
    # `registrationSharedSecretExistingSecret`.
    registrationSharedSecret:
      value: {{ derivePassword 1 "long" $masterPassword "synapse" "registrationSharedSecret" | sha1sum | quote }}
      create: true
      name: "synapse-registration-shared-secret"
      key: "secret"
  certificates:
    password:
      value: {{ derivePassword 1 "long" $masterPassword "certificates" "password" | sha1sum | quote }}
      create: true
      name: "certificates-keystore-password"
      key: "password"
      # create: false is client-limited here.
      # Value is read literally by the Java truststore config of:
      # - OX
      # - Nubus
      # Existing secret is supported by:
      # - XWiki
  notes:
    djangoSecretKey:
      value: {{ derivePassword 1 "long" $masterPassword "notes" "djangoSecretKey" | sha256sum | quote }}
      create: true
      name: "notes-django-secret-key"
      key: "djangoSecretKey"
    superuser:
      value: {{ derivePassword 1 "long" $masterPassword "notes" "superuser" | sha1sum | quote }}
      create: true
      name: "notes-superuser-password"
      key: "djangoSuperuserPassword"
    collaborationSecret:
      value: {{ derivePassword 1 "long" $masterPassword "notes" "collaborationSecret" | sha1sum | quote }}
      create: true
      name: "notes-collaboration-secret"
      key: "collaborationServerSecret"
...
