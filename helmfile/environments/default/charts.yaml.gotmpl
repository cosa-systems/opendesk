    # providerResponsible: "Open-Xchange"
    # upstreamMirrorTagFilterRegEx: '^(\d+)\.(\d+)\.(\d+)$'
    # upstreamMirrorStartFrom: ["2", "2", "37"]
    # upstreamRegistry: "https://registry.open-xchange.com"
    # upstreamRepository: "appsuite-public-sector/charts/appsuite-public-sector"
    # cosa fork: self-contained CE umbrella (vendored from the
    # opencode.de CE mirror). Bundled core-mw suppresses the
    # secret-envvars Secret when existingEnvSecret supplies the
    # credentials; docconv + imageconv gate their checksum/commonEnv
    # annotation (-cosa.2) so the render is deterministic. Source:
    # https://github.com/cosa-systems/ox-appsuite-middleware/tree/cosa-deploy
    registry: "ghcr.io"
    repository: "cosa-systems"
    name: "appsuite-public-sector"
    version: "2.30.58-cosa.2"
    verify: false
