  nubus:
    # providerCategory: "Supplier"
    # providerResponsible: "Univention"
    # upstreamRegistry: "https://artifacts.software-univention.de"
    # upstreamRepository: "nubus/charts/nubus"
    # upstreamMirrorTagFilterRegEx: '^(\d+)\.(\d+)\.(\d+)$'
    # upstreamMirrorStartFrom: ["0", "19", "3"]
    # cosa fork rebased on v1.19.1 — repoints the bundled
    # `stack-data-ums 0.102.4` dep at the cosa fork that carries
    # the existingSecret knobs + prepare-context initContainer.
    # Source: https://github.com/cosa-systems/nubus-stack/tree/cosa-deploy
    registry: "ghcr.io"
    repository: "cosa-systems"
    name: "nubus"
    # cosa.3 adds nubusStackDataUms.administratorPasswordSecret.create so the
    # admin password Secret can be suppressed under externalSecrets.
    # cosa.4 bundles stack-data-ums 0.102.5-cosa.3, whose generalised
    # contextUsers map lets us provision the OX system user password
    # (oxSystemUser -> NUBUS_LDAPSEARCH_OX) via the chart's native runtime
    # merge instead of a post-renderer.
    version: "1.19.2-cosa.4"
    verify: false
