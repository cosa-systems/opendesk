    # upstreamRegistry: "https://registry.opencode.de"
    # upstreamRepository: "bmi/opendesk/components/platform-development/charts/opendesk-keycloak-bootstrap/opendesk-keycloak-bootstrap"
    # cosa fork: preparePossibleExistingSecret walks the values subtree recursively
    # so nested `secret.existingSecret` refs are mounted (the upstream helper matched
    # only a direct `existingSecret` key, so the app-client OIDC secrets were never
    # mounted and the bootstrap FileNotFound-crashed on ./app/secrets/<secret>-<key>).
    # Source: https://github.com/cosa-systems/opendesk-keycloak-bootstrap/tree/cosa-deploy
    registry: "ghcr.io"
    repository: "cosa-systems"
    name: "opendesk-keycloak-bootstrap"
