---
{{- $relayPassword := env "SMTP_PASSWORD" | default "" }}
smtp:
  host: ""
  port: 587
  username: ""
  # Password for an external SMTP relay, seeded from the SMTP_PASSWORD environment variable. Same
  # value/create/name/key convention as the entries in secrets.yaml.gotmpl: delivered as the Secret
  # `name`/`key`, which both Postfix releases read through the chart's
  # `relayHost.authentication.password.existingSecret`.
  #
  # Provisioned only when SMTP_PASSWORD actually carries a relay password, so a deployment without an
  # external relay gets no Secret it would never reference. With `name` empty the releases fall back
  # to the inline `value`, which keeps a deployment that sets `value` in its own values working as
  # before; to bring your own Secret, set `create: false` and name it here.
  password:
    value: {{ $relayPassword | quote }}
    create: {{ if ne $relayPassword "" }}true{{ else }}false{{ end }}
    name: {{ if ne $relayPassword "" }}"smtp-relay-password"{{ else }}""{{ end }}
    key: "password"
  localpartNoReply: "no-reply"
  spamMilter:
    host: ""
    port: 11332

  # Helo name postfix-ox should use
  heloName: ~
  # Helo name internal postfix should use
  internalHeloName: ~

  # For the following settings to have effect `apps.dkimpy.enabled` must be `true`.
  dkim:
    key:
      # DKIM private key as plaintext value.
      value: ""

      # DKIM private key from existing secret. As a higher precedence than the plain `value`.
      secret:
        name: ""
        key: ""
    selector: "rsa"
    useED25519: false

  security:
    # Postfix defaults
    # Ref.: https://www.postfix.org/postconf.5.html#smtpd_sasl_security_options
    smtpdSASLSecurityOptions:
      - "noanonymous"
    # Ref.: https://www.postfix.org/postconf.5.html#smtpd_sasl_tls_security_options
    smtpdSASLTLSSecurityOptions:
      - "noanonymous"
    # Postfix defaults
    # Ref.: https://www.postfix.org/postconf.5.html#smtp_sasl_security_options
    smtpSASLSecurityOptions:
      - "noanonymous"
      - "noplaintext"
    # Ref.: https://www.postfix.org/postconf.5.html#smtp_sasl_tls_security_options
    smtpSASLTLSSecurityOptions:
      - "noanonymous"
...
