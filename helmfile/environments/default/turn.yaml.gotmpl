---
turn:
  transport: "udp"
  # The shared secret of the TURN server (coturn's static-auth-secret), which Jitsi's prosody and
  # Synapse use to mint time-limited TURN credentials. Same value/create/name/key convention as the
  # entries in secrets.yaml.gotmpl: delivered as the Secret `name`/`key` and read from there by both
  # consumers - prosody through an env reference, Synapse through `turn_shared_secret_path`.
  credentials:
    value: {{ env "TURN_CREDENTIALS" | quote }}
    create: true
    name: "turn-credentials"
    key: "credentials"
  server:
    host: ""
    port: "3478"
  tls:
    host: ""
    port: "5349"
...
